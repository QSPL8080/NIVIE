# Copy this file to .env.local and fill in your own values.
# .env.local is never committed (see .gitignore).
# If a value contains a $ sign, write it as \$ (Next.js treats $NAME as a variable).

# MySQL (MySQL Workbench / MySQL80 service uses port 3306 by default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=nivie_db

# Admin panel login  (/login → /panel)
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=Nivie Admin
ADMIN_PASSWORD=choose-a-strong-password

# Any long random text (at least 16 characters) used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string
