# LOCAL settings: copy this file to .env.local and fill in your own values.
# .env.local is never pushed to GitHub (see .gitignore), so your PC keeps using
# your local MySQL. The live site gets its values from Hostinger hPanel →
# Node.js app → Environment variables (same names, Hostinger database details).
# If a value contains a $ sign, write it as \$ (Next.js treats $NAME as a variable).

# MySQL — local: MySQL Workbench / MySQL80 on port 3306
#         Hostinger: MYSQL_HOST=localhost, and the u123456789_… name/user from hPanel
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=nivie_db

# Admin panel login  (/login → /panel)
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=Nivie Admin
ADMIN_PASSWORD=choose-a-strong-password

# Any long random text (at least 16 characters) used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# WhatsApp alert for every new enquiry (CallMeBot — free, for your own number).
# One-time: from the WhatsApp of the receiving number, send
#   "I allow callmebot to send me messages" to the CallMeBot number listed on
#   https://www.callmebot.com/blog/free-api-whatsapp-messages/ — it replies with your API key.
# Leave empty to switch alerts off (enquiries are still saved).
WHATSAPP_NOTIFY_PHONE=+919226333902
CALLMEBOT_APIKEY=

# Optional: your live website address, used for the "Open panel" link in WhatsApp alerts
SITE_URL=https://niviedesignsstudio.com
